# =========================
# Django
# =========================
DJANGO_SECRET_KEY=evidra-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tokyo

# =========================
# Azure OpenAI (Embeddings / Chat)
# =========================
# Azure OpenAIリソースエンドポイント
AZURE_OPENAI_ENDPOINT=***********************
# ポータル発行キー
AZURE_OPENAI_API_KEY=***********************
# デプロイ済みの埋め込みモデル
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# デプロイ済みのチャットモデル
AZURE_OPENAI_CHAT_DEPLOYMENT=o4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# =========================
# Azure Cosmos DB (SQL API) - RAG用チャンク格納
# =========================
COSMOS_ENDPOINT=***********************
COSMOS_KEY=***********************
COSMOS_DB=chatdb
# RAGのチャンクを入れるコンテナ
COSMOS_CONTAINER_RAG=container01

# =========================
# （将来拡張予定）Azure Blob Storage
# いまはローカル保存ですが、本番移行時に使います
# =========================
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=evidra-artifacts

# =========================
# 実験の再現性
# =========================
GLOBAL_RANDOM_SEED=42
PYTHONHASHSEED=42

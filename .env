# =========================
# Django
# =========================
DJANGO_SECRET_KEY=evidra-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tokyo

# =========================
# Azure OpenAI (Embeddings / Chat)
# =========================
# Azure OpenAI リソースのエンドポイント（末尾スラッシュ可）
AZURE_OPENAI_ENDPOINT=https://25jsg-mfvcssky-swedencentral.cognitiveservices.azure.com/openai/deployments/o4-mini/chat/completions?api-version=2025-01-01-preview
# ポータルで発行したキー
AZURE_OPENAI_API_KEY=5Y84lAkbeiDYtgIc21RMfPWl6m6nRMk34ynyAnVLH3NI3UPdA1g9JQQJ99BIACfhMk5XJ3w3AAAAACOGhRVl
# デプロイ済みの埋め込みモデルの「デプロイ名」
# 例: text-embedding-3-large をデプロイしているなら、その "Deployment name"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# デプロイ済みのチャットモデルの「デプロイ名」
# 例: gpt-4o / gpt-4o-mini / gpt-35-turbo 等の "Deployment name"
AZURE_OPENAI_CHAT_DEPLOYMENT=o4-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# =========================
# Azure Cosmos DB (SQL API) - RAG用チャンク格納
# =========================
COSMOS_ENDPOINT=https://evidra-cosmos.documents.azure.com:443/
COSMOS_KEY=FG6Ox8CQV6YNMeYU9dwYscKkzmhGvMt2j698aQv2uGksJxfxe3SUXIePtdlI2A3fh1omRrQ4DEJ8ACDbnEy84g==
COSMOS_DB=chatdb
# RAGのチャンクを入れるコンテナ名（例: rag_chunks）
COSMOS_CONTAINER_RAG=container01

# =========================
# （将来拡張）Azure Blob Storage
# いまはローカル保存ですが、本番移行時に使います
# =========================
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=evidra-artifacts

# =========================
# 実験の再現性（任意）
# =========================
GLOBAL_RANDOM_SEED=42
PYTHONHASHSEED=42
